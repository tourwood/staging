# cPanel / Apache settings
<Files "config.php">
  Require all denied
</Files>
<Files "config.sample.php">
  Require all denied
</Files>

<FilesMatch "(?i)(quote-log|form-attempts).*\.txt$">
  Require all denied
</FilesMatch>

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(webp|png|jpg|css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

RewriteEngine On

# --- Permanent (301) redirects from the old WordPress site so search rankings and links carry over ---
# Pages kept at the SAME URL as before need no redirect: /why-tourwood/ /emergencies/ /covid-deep-cleaning/ /quality-assurance/ /environment/
RewriteRule ^home/?$ / [R=301,L]
RewriteRule ^services-client-sectors/?$ /services/ [R=301,L]
RewriteRule ^contact-us/?$ /contact/ [R=301,L]
# Old WordPress "project" stub pages (about 35 words each) -> closest new service page
RewriteRule ^project/(general-office-cleaning|industrial-warehouse-cleaning)/?$ /services/commercial-industrial/ [R=301,L]
RewriteRule ^project/(property-maintenance|electrical-maintenance-services|plumbing|glazing|garden-maintenance-services|chemical-acid-cleaning)/?$ /services/maintenance-specialist/ [R=301,L]
RewriteRule ^project/?$ /services/ [R=301,L]
# Old WordPress category archive pages
RewriteRule ^project_category/ /services/ [R=301,L]
# Old test pages (one contains unrelated German spam content): tell search engines they are gone (410)
RewriteRule ^(testing-2|hover-images)/?$ - [G,L]
# Anything else found later (e.g. ?p=ID links) can be added here.

# --- Uncomment once SSL is active on the live site (force https) ---
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# --- Canonical host is www (matches the old site). Uncomment to send non-www to www: ---
# RewriteCond %{HTTP_HOST} ^tourwood\.com\.au$ [NC]
# RewriteRule ^(.*)$ https://www.tourwood.com.au/$1 [R=301,L]
